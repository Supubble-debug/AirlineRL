    "creation_tools": [
      "add_child_incident",
      "add_location",
      "add_new_service",
      "add_new_sla_definition",
      "add_new_user",
      "add_new_user_group",
      "create_knowledge_article",
      "create_problem",
      "register_configuration_item",
      "register_new_service_offering"
    ],
    "split_rule": "enumerate all family->split assignments; keep sizes within size_ranges, >= 2 tasks of each tenancy in dev and heldout, >= 2 families in dev, >= 5 families and >= 3 business types in heldout, no family above 50% of heldout; score = sum |size - target| + 10 * sum over dev/heldout |msp share - overall msp share|; lowest score wins, ties broken by random.Random(seed).choice over the sorted tied assignments",
